config BR2_PACKAGE_ARDUCAM_PIVARIETY_SDK
	bool "arducam-pivariety-sdk"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ZLIB
	help
	  Runtime library and headers supplied by Arducam for the Pivariety
	  camera bridge. The library reads the sensor tuning and control-delay
	  data stored in the bridge MCU.

comment "arducam-pivariety-sdk needs aarch64 with C++ support"
	depends on !BR2_aarch64 || !BR2_INSTALL_LIBSTDCPP
