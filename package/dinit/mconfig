# Buildroot cross-compilation configuration for Dinit.

SBINDIR=/usr/sbin
BINDIR=/usr/bin
MANDIR=/usr/share/man
SYSCONTROLSOCKET=/run/dinitctl

CXX=@TARGET_CXX@
CPPFLAGS=
CXXFLAGS=-std=c++11 -Os -Wall -fno-rtti
LDFLAGS_BASE=
LDFLAGS=@TARGET_LDFLAGS@
BUILD_SHUTDOWN=yes

USE_UTMPX=0
SUPPORT_CGROUPS=0
SUPPORT_CAPABILITIES=0
SUPPORT_IOPRIO=0
SUPPORT_OOM_ADJ=0

DEFAULT_AUTO_RESTART=NEVER
DEFAULT_START_TIMEOUT=60
DEFAULT_STOP_TIMEOUT=10
