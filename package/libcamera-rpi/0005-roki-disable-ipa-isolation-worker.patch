From: Roki Buildroot <build@roki.local>
Subject: [PATCH] roki: remove IPA isolation worker path

The Roki image trusts its single VC4 IPA module and never supports foreign IPA
modules. Instantiate only the in-process Threaded adapter and do not build or
install IPA proxy workers.

---
 include/libcamera/internal/ipa_manager.h | 8 +-------
 src/libcamera/meson.build                | 2 --
 2 files changed, 1 insertion(+), 9 deletions(-)

diff --git a/include/libcamera/internal/ipa_manager.h b/include/libcamera/internal/ipa_manager.h
index 7d896838..bfb1e0af 100644
--- a/include/libcamera/internal/ipa_manager.h
+++ b/include/libcamera/internal/ipa_manager.h
@@ -41,12 +41,7 @@
 		if (!m)
 			return nullptr;
 
-		auto proxy = [&]() -> std::unique_ptr<T> {
-			if (isSignatureValid(m))
-				return std::make_unique<typename T::Threaded>(m, cm_);
-			else
-				return std::make_unique<typename T::Isolated>(m, cm_);
-		}();
+		auto proxy = std::make_unique<typename T::Threaded>(m, cm_);
 
 		if (!proxy->isValid()) {
 			LOG(IPAManager, Error) << "Failed to load proxy";
diff --git a/src/libcamera/meson.build b/src/libcamera/meson.build
index 2ff9d739..b89fdf00 100644
--- a/src/libcamera/meson.build
+++ b/src/libcamera/meson.build
@@ -219 +218,0 @@
-subdir('proxy/worker')
-- 
2.51.0
