+std::unique_ptr<ValueNode> YamlParser::parse(const std::string &content)
+{
+	YamlParserContext context;
+
+	if (context.init(content))
+		return nullptr;
+
+	std::unique_ptr<ValueNode> root = std::make_unique<ValueNode>();
+
+	if (context.parseContent(*root)) {
+		LOG(YamlParser, Error)
+			<< "Failed to parse YAML content from memory";
+		return nullptr;
+	}
+
+	return root;
+}
