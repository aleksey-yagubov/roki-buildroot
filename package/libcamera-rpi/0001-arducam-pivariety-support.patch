+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Camera helper for Arducam Pivariety sensors.
+ *
+ * The libcamera glue is open, while the MCU tuning-data protocol is provided
+ * by Arducam's small libarducam_pivariety runtime library.
+ */
+
+#include <cstdio>
+
+#include "cam_helper.h"
+
+#include "arducam/arducam_pivariety.hpp"
+
+using namespace RPiController;
+
+class CamHelperArducam : public CamHelper
+{
+public:
+	CamHelperArducam();
+	uint32_t gainCode(double gain) const override;
+	double gain(uint32_t gainCode) const override;
+	int getDelays(int &exposureDelay, int &gainDelay,
+		      int &vblankDelay, int &hblankDelay) const override;
+	unsigned int hideFramesModeSwitch() const override;
+	unsigned int mistrustMetadataStartup() const override;
+	unsigned int mistrustMetadataModeSwitch() const override;
+	std::string getTuningData() override;
+	void setI2C(int16_t i2cBus, int16_t i2cAddress) override;
+
+private:
+	static constexpr int frameIntegrationDiff = 4;
+
+	int exposureDelay_ = 2;
+	int gainDelay_ = 2;
+	int vblankDelay_ = 2;
+	int hideFramesModeSwitch_ = 2;
+	std::string tuningData_;
+};
+
+CamHelperArducam::CamHelperArducam()
+	: CamHelper(nullptr, frameIntegrationDiff)
+{
+}
+
+void CamHelperArducam::setI2C(int16_t i2cBus, int16_t i2cAddress)
+{
+	CamHelper::setI2C(i2cBus, i2cAddress);
+
+	/*
+	 * The Pivariety bridge is on the primary controller, i2c-0. Use it when
+	 * libcamera cannot derive an I2C bus number from the media subdevice.
+	 */
+	int bus = i2cBus_ != -1 ? i2cBus_ : 0;
+
+	Arducam::ArducamUtils arducam(bus);
+	tuningData_ = arducam.readJson();
+
+	if (!arducam.convert(tuningData_)) {
+		std::fprintf(stderr, "Arducam Pivariety camera has old tuning data format\n");
+		arducam.writeJson(tuningData_);
+	}
+
+	exposureDelay_ = DEFAULT(arducam.readInfo(Arducam::EXPOSURE_DELAY), 2);
+	gainDelay_ = DEFAULT(arducam.readInfo(Arducam::GAIN_DELAY), 2);
+	vblankDelay_ = DEFAULT(arducam.readInfo(Arducam::VBLANK_DELAY), 2);
+
+	uint32_t version = arducam.getVersion();
+	if (version != UNKNOWN && (version >> 16) >= 1 && (version & 0xffff) > 1)
+		hideFramesModeSwitch_ = DEFAULT(arducam.readInfo(Arducam::HIDE_FRAMES), 2);
+}
+
+uint32_t CamHelperArducam::gainCode(double gain) const
+{
+	return static_cast<uint32_t>(gain * 100);
+}
+
+double CamHelperArducam::gain(uint32_t gainCode) const
+{
+	return static_cast<double>(gainCode) / 100.0;
+}
+
+int CamHelperArducam::getDelays(int &exposureDelay, int &gainDelay,
+				int &vblankDelay, int &hblankDelay) const
+{
+	exposureDelay = exposureDelay_;
+	gainDelay = gainDelay_;
+	vblankDelay = vblankDelay_;
+	hblankDelay = 2;
+	return true;
+}
+
+unsigned int CamHelperArducam::hideFramesModeSwitch() const
+{
+	return hideFramesModeSwitch_;
+}
+
+unsigned int CamHelperArducam::mistrustMetadataStartup() const
+{
+	return 2;
+}
+
+unsigned int CamHelperArducam::mistrustMetadataModeSwitch() const
+{
+	return 2;
+}
+
+std::string CamHelperArducam::getTuningData()
+{
+	if (target_ == "pisp")
+		Arducam::ArducamUtils::convertPISP(tuningData_);
+
+	return tuningData_;
+}
+
+static CamHelper *create()
+{
+	return new CamHelperArducam();
+}
+
+static RegisterCamHelper reg("arducam-pivariety", &create);
+static RegisterCamHelper regAlias("arducam_pivariety", &create);
