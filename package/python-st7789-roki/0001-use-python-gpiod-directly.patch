 OUTL = gpiod.LineSettings(direction=Direction.OUTPUT, output_value=Value.INACTIVE)
 
+
+def get_named_pin(name, label, settings):
+    """Request a GPIO line identified by its Device Tree line name."""
+    for path in sorted(glob.glob("/dev/gpiochip*")):
+        if not gpiod.is_gpiochip_device(path):
+            continue
+        chip = gpiod.Chip(path)
+        try:
+            offset = chip.line_offset_from_id(name)
+        except OSError:
+            chip.close()
+            continue
+        lines = chip.request_lines(
+            consumer=f"st7789-{label}", config={offset: settings}
+        )
+        return lines, offset
+    raise RuntimeError(f"GPIO line {name!r} was not found")
+
