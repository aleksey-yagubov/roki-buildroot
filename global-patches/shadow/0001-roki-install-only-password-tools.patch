--- a/src/Makefile.in	2025-06-24 23:28:30.780209795 +0300
+++ b/src/Makefile.in	2026-09-18 13:30:12.563067564 +0300
@@ -1597,6 +1597,38 @@
 	set -e; for i in $(suidusbins); do \
 		chmod $(suidperms) $(DESTDIR)$(usbindir)/$$i; \
 	done
+	rm -f $(DESTDIR)$(bindir)/login \
+		$(DESTDIR)$(bindir)/getsubids \
+		$(DESTDIR)$(sbindir)/nologin \
+		$(DESTDIR)$(ubindir)/faillog \
+		$(DESTDIR)$(ubindir)/chage \
+		$(DESTDIR)$(ubindir)/chfn \
