From: Roki Buildroot <noreply@roki.local>
Subject: [PATCH] install only password-changing tools on Roki

The appliance has no local login path and does not create or manage user
accounts at runtime. Keep passwd and chpasswd for maintenance, but remove the
other Shadow programs and unused login policy files after installation.

---
 etc/Makefile.am | 11 ++++++++++-
 etc/Makefile.in | 13 +++++++++++--
 etc/roki-login.defs | 6 ++++++
 src/Makefile.am | 32 ++++++++++++++++++++++++++++++++
 src/Makefile.in | 32 ++++++++++++++++++++++++++++++++
 5 files changed, 93 insertions(+), 3 deletions(-)

diff -ruN a/etc/Makefile.am b/etc/Makefile.am
--- a/etc/Makefile.am	2025-06-24 23:28:01.047828631 +0300
+++ b/etc/Makefile.am	2026-09-18 13:30:12.555067564 +0300
@@ -1,7 +1,7 @@
 # This is a dummy Makefile.am to get automake work flawlessly,
 # and also cooperate to make a distribution for `make dist'
 
-sysconf_DATA = login.defs
+sysconf_DATA =
 
 defaultdir = $(sysconfdir)/default
 default_DATA =
@@ -17,7 +17,14 @@
 
 EXTRA_DIST = \
 	$(nonpam_files) \
+	roki-login.defs \
 	$(sysconf_DATA) \
 	$(default_DATA)
 
 SUBDIRS = pam.d shadow-maint
+
+install-data-hook:
+	$(MKDIR_P) $(DESTDIR)$(sysconfdir)
+	$(INSTALL_DATA) $(srcdir)/roki-login.defs $(DESTDIR)$(sysconfdir)/login.defs
+	rm -f $(DESTDIR)$(sysconfdir)/limits \
+		$(DESTDIR)$(sysconfdir)/login.access
diff -ruN a/etc/Makefile.in b/etc/Makefile.in
--- a/etc/Makefile.in	2025-06-24 23:28:29.960216510 +0300
+++ b/etc/Makefile.in	2026-09-18 13:30:12.558067564 +0300
@@ -395,7 +395,7 @@
 top_build_prefix = @top_build_prefix@
 top_builddir = @top_builddir@
 top_srcdir = @top_srcdir@
-sysconf_DATA = login.defs
+sysconf_DATA =
 defaultdir = $(sysconfdir)/default
 default_DATA = 
 nonpam_files = \
@@ -406,10 +406,17 @@
 @USE_PAM_FALSE@nonpam_DATA = $(nonpam_files)
 EXTRA_DIST = \
 	$(nonpam_files) \
+	roki-login.defs \
 	$(sysconf_DATA) \
 	$(default_DATA)
 
 SUBDIRS = pam.d shadow-maint
+
+install-data-hook:
+	$(MKDIR_P) $(DESTDIR)$(sysconfdir)
+	$(INSTALL_DATA) $(srcdir)/roki-login.defs $(DESTDIR)$(sysconfdir)/login.defs
+	rm -f $(DESTDIR)$(sysconfdir)/limits \
+		$(DESTDIR)$(sysconfdir)/login.access
 all: all-recursive
 
 .SUFFIXES:
@@ -726,7 +733,7 @@
 
 info-am:
 
-install-data-am: install-defaultDATA install-nonpamDATA
+install-data-am: install-defaultDATA install-nonpamDATA install-data-hook
 
 install-dvi: install-dvi-recursive
 
diff -ruN a/etc/roki-login.defs b/etc/roki-login.defs
--- a/etc/roki-login.defs	1970-01-01 03:00:00.000000000 +0300
+++ b/etc/roki-login.defs	2026-09-18 13:30:12.564067564 +0300
@@ -0,0 +1,6 @@
+# Password policy for the Roki appliance.
+#
+# Buildroot provisions the initial root password. These settings are used only
+# by passwd and chpasswd when a maintainer changes it on a running robot.
+ENCRYPT_METHOD SHA256
+PASS_MIN_LEN 5
diff -ruN a/src/Makefile.am b/src/Makefile.am
--- a/src/Makefile.am	2025-06-24 23:28:01.128499046 +0300
+++ b/src/Makefile.am	2026-09-18 13:30:12.560067564 +0300
@@ -150,6 +150,38 @@
 	set -e; for i in $(suidusbins); do \
 		chmod $(suidperms) $(DESTDIR)$(usbindir)/$$i; \
 	done
+	rm -f $(DESTDIR)$(bindir)/login \
+		$(DESTDIR)$(bindir)/getsubids \
+		$(DESTDIR)$(sbindir)/nologin \
+		$(DESTDIR)$(ubindir)/faillog \
+		$(DESTDIR)$(ubindir)/chage \
+		$(DESTDIR)$(ubindir)/chfn \
+		$(DESTDIR)$(ubindir)/chsh \
+		$(DESTDIR)$(ubindir)/expiry \
+		$(DESTDIR)$(ubindir)/gpasswd \
+		$(DESTDIR)$(ubindir)/lastlog \
+		$(DESTDIR)$(ubindir)/newgidmap \
+		$(DESTDIR)$(ubindir)/newgrp \
+		$(DESTDIR)$(ubindir)/newuidmap \
+		$(DESTDIR)$(ubindir)/sg \
+		$(DESTDIR)$(usbindir)/chgpasswd \
+		$(DESTDIR)$(usbindir)/groupadd \
+		$(DESTDIR)$(usbindir)/groupdel \
+		$(DESTDIR)$(usbindir)/groupmems \
+		$(DESTDIR)$(usbindir)/groupmod \
+		$(DESTDIR)$(usbindir)/grpck \
+		$(DESTDIR)$(usbindir)/grpconv \
+		$(DESTDIR)$(usbindir)/grpunconv \
+		$(DESTDIR)$(usbindir)/logoutd \
+		$(DESTDIR)$(usbindir)/newusers \
+		$(DESTDIR)$(usbindir)/pwck \
+		$(DESTDIR)$(usbindir)/pwconv \
+		$(DESTDIR)$(usbindir)/pwunconv \
+		$(DESTDIR)$(usbindir)/useradd \
+		$(DESTDIR)$(usbindir)/userdel \
+		$(DESTDIR)$(usbindir)/usermod \
+		$(DESTDIR)$(usbindir)/vipw \
+		$(DESTDIR)$(usbindir)/vigr
 if WITH_TCB
 	set -e; for i in $(shadowsgidubins); do \
 		chown root:shadow $(DESTDIR)$(ubindir)/$$i; \
