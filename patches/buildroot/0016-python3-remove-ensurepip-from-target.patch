From: ROKI Buildroot <buildroot@roki.local>
Subject: [PATCH] package/python3: remove unused ensurepip bootstrap from target

The target image does not provide pip or the Python SSL module. Keep package
installation reproducible through Buildroot and omit ensurepip's bundled pip
wheel from the runtime filesystem.

--- a/package/python3/python3.mk
+++ b/package/python3/python3.mk
@@ -226,5 +226,11 @@ PYTHON3_POST_INSTALL_TARGET_HOOKS += PYTHON3_REMOVE_USELESS_FILES
 PYTHON3_POST_INSTALL_TARGET_HOOKS += PYTHON3_REMOVE_USELESS_FILES
 
+define PYTHON3_REMOVE_ENSUREPIP
+	rm -rf $(TARGET_DIR)/usr/lib/python$(PYTHON3_VERSION_MAJOR)/ensurepip
+endef
+
+PYTHON3_POST_INSTALL_TARGET_HOOKS += PYTHON3_REMOVE_ENSUREPIP
+
 #
 # Make sure libpython gets stripped out on target
 #
