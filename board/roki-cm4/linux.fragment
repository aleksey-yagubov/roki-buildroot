# CONFIG_COMMON_CLK_SI5351 is not set
# CONFIG_BCM74110_MAILBOX is not set

# Root is ext4; the boot partition is FAT. Other local filesystems are unused.
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
# CONFIG_F2FS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_SMBFS is not set
# CONFIG_9P_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_DLM is not set

# Keep the ordinary flock()/fcntl() locking and inotify ABIs for normal Linux
# userspace.  The remaining notification, export, ACL/xattr and persistent
# crash-log facilities are unused on this appliance.
CONFIG_FILE_LOCKING=y
# CONFIG_MANDATORY_FILE_LOCKING is not set
# CONFIG_FS_POSIX_ACL is not set
# CONFIG_EXPORTFS is not set
CONFIG_FSNOTIFY=y
# CONFIG_DNOTIFY is not set
CONFIG_INOTIFY_USER=y
# CONFIG_FANOTIFY is not set
# CONFIG_TMPFS_POSIX_ACL is not set
# CONFIG_TMPFS_XATTR is not set
# CONFIG_CONFIGFS_FS is not set
# CONFIG_PSTORE is not set
# CONFIG_EXT4_FS_POSIX_ACL is not set
# CONFIG_OF_CONFIGFS is not set

# The only non-ext4 filesystem mounted by the image is the ASCII-named FAT
# boot partition.  Keep its default CP437 plus UTF-8, built in rather than as
# a boot-time module; all other legacy codepages are unnecessary.
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
# CONFIG_NLS_CODEPAGE_737 is not set
# CONFIG_NLS_CODEPAGE_775 is not set
# CONFIG_NLS_CODEPAGE_850 is not set
# CONFIG_NLS_CODEPAGE_852 is not set
# CONFIG_NLS_CODEPAGE_855 is not set
# CONFIG_NLS_CODEPAGE_857 is not set
# CONFIG_NLS_CODEPAGE_860 is not set
# CONFIG_NLS_CODEPAGE_861 is not set
# CONFIG_NLS_CODEPAGE_862 is not set
# CONFIG_NLS_CODEPAGE_863 is not set
# CONFIG_NLS_CODEPAGE_864 is not set
# CONFIG_NLS_CODEPAGE_865 is not set
# CONFIG_NLS_CODEPAGE_866 is not set
# CONFIG_NLS_CODEPAGE_869 is not set
# CONFIG_NLS_CODEPAGE_874 is not set
# CONFIG_NLS_CODEPAGE_932 is not set
# CONFIG_NLS_CODEPAGE_936 is not set
# CONFIG_NLS_CODEPAGE_949 is not set
# CONFIG_NLS_CODEPAGE_950 is not set
# CONFIG_NLS_CODEPAGE_1250 is not set
# CONFIG_NLS_CODEPAGE_1251 is not set
CONFIG_NLS_ASCII=y
# CONFIG_NLS_ISO8859_1 is not set
# CONFIG_NLS_ISO8859_2 is not set
# CONFIG_NLS_ISO8859_3 is not set
# CONFIG_NLS_ISO8859_4 is not set
# CONFIG_NLS_ISO8859_5 is not set
# CONFIG_NLS_ISO8859_6 is not set
# CONFIG_NLS_ISO8859_7 is not set
# CONFIG_NLS_ISO8859_8 is not set
# CONFIG_NLS_ISO8859_9 is not set
# CONFIG_NLS_ISO8859_13 is not set
# CONFIG_NLS_ISO8859_14 is not set
# CONFIG_NLS_ISO8859_15 is not set
# CONFIG_NLS_KOI8_R is not set
# CONFIG_NLS_KOI8_U is not set
CONFIG_NLS_UTF8=y
# CONFIG_UNICODE is not set

# TLS is implemented by OpenSSL in userspace.  No kernel-TLS offload is used.
# CONFIG_TLS is not set

# IWD uses AF_ALG for WPA crypto.  Buildroot enables its exact crypto subset;
# kernel keyrings and certificate parsers remain disabled above.

# No eBPF programs, JIT, socket filters, or cgroup-BPF policy are used.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_CGROUP_BPF is not set

# The head has ordinary IPv4 Ethernet and Wi-Fi, not an NFS root/router or a
# software switch.  Preserve the normal TCP/IP stack and CUBIC only.
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTIPLE_TABLES is not set
# CONFIG_IP_ROUTE_MULTIPATH is not set
# CONFIG_IP_ROUTE_VERBOSE is not set
# CONFIG_IP_PNP is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_BBR is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_NET_L3_MASTER_DEV is not set
# CONFIG_NET_FLOW_LIMIT is not set

# Ethernet vendor menus: BCMGENET and the on-module Broadcom PHY are the only
# wired-network hardware.  Keep the Broadcom menu, and close all others so
# their drivers cannot be selected indirectly during later configuration.
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
# CONFIG_NET_VENDOR_AGERE is not set
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_ALTEON is not set
# CONFIG_NET_VENDOR_AMAZON is not set
# CONFIG_NET_VENDOR_AMD is not set
# CONFIG_NET_VENDOR_AQUANTIA is not set
# CONFIG_NET_VENDOR_ARC is not set
# CONFIG_NET_VENDOR_ASIX is not set
# CONFIG_NET_VENDOR_ATHEROS is not set
CONFIG_NET_VENDOR_BROADCOM=y
# CONFIG_NET_VENDOR_CADENCE is not set
# CONFIG_NET_VENDOR_CAVIUM is not set
# CONFIG_NET_VENDOR_CHELSIO is not set
# CONFIG_NET_VENDOR_CISCO is not set
# CONFIG_NET_VENDOR_CORTINA is not set
# CONFIG_NET_VENDOR_DAVICOM is not set
# CONFIG_NET_VENDOR_DEC is not set
# CONFIG_NET_VENDOR_DLINK is not set
# CONFIG_NET_VENDOR_EMULEX is not set
# CONFIG_NET_VENDOR_ENGLEDER is not set
# CONFIG_NET_VENDOR_EZCHIP is not set
# CONFIG_NET_VENDOR_FUNGIBLE is not set
# CONFIG_NET_VENDOR_GOOGLE is not set
# CONFIG_NET_VENDOR_HISILICON is not set
# CONFIG_NET_VENDOR_HUAWEI is not set
# CONFIG_NET_VENDOR_I825XX is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_ADI is not set
# CONFIG_NET_VENDOR_LITEX is not set
# CONFIG_NET_VENDOR_MARVELL is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_META is not set
# CONFIG_NET_VENDOR_MICREL is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_MICROSEMI is not set
# CONFIG_NET_VENDOR_MICROSOFT is not set
# CONFIG_NET_VENDOR_MYRI is not set
# CONFIG_NET_VENDOR_NI is not set
# CONFIG_NET_VENDOR_NATSEMI is not set
# CONFIG_NET_VENDOR_NETERION is not set
# CONFIG_NET_VENDOR_NETRONOME is not set
# CONFIG_NET_VENDOR_8390 is not set
# CONFIG_NET_VENDOR_NVIDIA is not set
# CONFIG_NET_VENDOR_OKI is not set
# CONFIG_NET_VENDOR_PACKET_ENGINES is not set
# CONFIG_NET_VENDOR_PENSANDO is not set
# CONFIG_NET_VENDOR_QLOGIC is not set
# CONFIG_NET_VENDOR_BROCADE is not set
# CONFIG_NET_VENDOR_QUALCOMM is not set
# CONFIG_NET_VENDOR_RDC is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_RENESAS is not set
# CONFIG_NET_VENDOR_ROCKER is not set
# CONFIG_NET_VENDOR_SAMSUNG is not set
# CONFIG_NET_VENDOR_SEEQ is not set
# CONFIG_NET_VENDOR_SILAN is not set
# CONFIG_NET_VENDOR_SIS is not set
# CONFIG_NET_VENDOR_SOLARFLARE is not set
# CONFIG_NET_VENDOR_SMSC is not set
# CONFIG_NET_VENDOR_SOCIONEXT is not set
# CONFIG_NET_VENDOR_STMICRO is not set
# CONFIG_NET_VENDOR_SUN is not set
# CONFIG_NET_VENDOR_SYNOPSYS is not set
# CONFIG_NET_VENDOR_TEHUTI is not set
# CONFIG_NET_VENDOR_TI is not set
# CONFIG_NET_VENDOR_VERTEXCOM is not set
# CONFIG_NET_VENDOR_VIA is not set
# CONFIG_NET_VENDOR_WANGXUN is not set
# CONFIG_NET_VENDOR_WIZNET is not set
# CONFIG_NET_VENDOR_XILINX is not set

# brcmfmac uses cfg80211 directly.  Keep rfkill itself but no legacy WEXT
# compatibility or input-device rfkill toggles.
# CONFIG_CFG80211_WEXT is not set
# CONFIG_CFG80211_CERTIFICATION_ONUS is not set
# The kernel loads the embedded regulatory.db directly; no legacy CRDA helper.
# CONFIG_CFG80211_CRDA_SUPPORT is not set
# CONFIG_CFG80211_DEFAULT_PS is not set
# CONFIG_RFKILL_INPUT is not set
# CONFIG_BRCMDBG is not set

# CM4's BCM54210-class Ethernet PHY is connected to BCMGENET over RGMII/MDIO.
# BCMGENET itself selects fixed-PHY, BCM7XXX PHY and UniMAC MDIO helper code;
# retain those Kconfig-mandated internals, but no third-party PHY driver.
CONFIG_BROADCOM_PHY=y
# CONFIG_MICREL_PHY is not set
# CONFIG_MICROCHIP_PHY is not set
# CONFIG_SMSC_PHY is not set

# Kernel facilities with no consumer on this fixed appliance.
# CONFIG_UEVENT_HELPER is not set
# CONFIG_ALLOW_DEV_COREDUMP is not set
# CONFIG_SRAM is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_GAMEPORT is not set
# CONFIG_TTY_PRINTK is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_HW_RANDOM_BCM74110 is not set
CONFIG_HW_RANDOM_IPROC_RNG200=y
# CONFIG_DEVPORT is not set
# CONFIG_SPI_MEM is not set
# CONFIG_HID_PID is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_STAGING_MEDIA is not set
# VIDEO_ISP_BCM2835 and VIDEO_CODEC_BCM2835 are VC04 staging drivers.
CONFIG_STAGING=y
# CONFIG_FSL_ERRATUM_A008585 is not set

# The stock CM4 DT regulates SDIO/eMMC through the VideoCore GPIO expander.
# Firmware supplies the GPIO transport, but Linux needs both regulator drivers.
CONFIG_GPIO_RASPBERRYPI_EXP=y
CONFIG_PINCTRL_BCM2835=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
# CONFIG_POWER_RESET_BRCMSTB is not set

# The BCM2835 SMI is a separate parallel memory interface, not SPI or eMMC.
# CONFIG_BCM2835_SMI is not set
# CONFIG_BCM2835_SMI_DEV is not set

# No PCI quirk entry targets BCM2711/PCIE_BRCMSTB or the uPD720201 endpoint.
# CONFIG_PCI_QUIRKS is not set

# This option only filters the media Kconfig menus; it does not add a media
# runtime driver and keeps the remaining camera stack manageable.
CONFIG_MEDIA_SUPPORT_FILTER=y

# No external connector, RAS, or actual IOMMU hardware exists on BCM2711.
# PCI on arm64 forces IOMMU_SUPPORT's generic framework on; no IOMMU driver is
# enabled. EXTCON, RAS and the generic PHY framework have no enabled provider
# or consumer here.
# CONFIG_EXTCON is not set
# CONFIG_RAS is not set
# CONFIG_GENERIC_PHY is not set

# This fixed appliance does not consume accounting telemetry, perf events or
# task/cpu isolation control.  Keep normal multi-core scheduling (SCHED_MC).
CONFIG_DEFAULT_HOSTNAME="roki"
# CONFIG_PSI is not set
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_BSD_PROCESS_ACCT_V3 is not set
# CONFIG_TASKSTATS is not set
# CONFIG_TASK_DELAY_ACCT is not set
# CONFIG_TASK_XACCT is not set
# CONFIG_TASK_IO_ACCOUNTING is not set
# CONFIG_CPU_ISOLATION is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_SECCOMP is not set
# CONFIG_SECCOMP_FILTER is not set
# CONFIG_SCHED_SMT is not set
# CONFIG_SCHED_CLUSTER is not set

# BCM2711's Cortex-A72 cores implement Armv8.0.  Do not carry kernel support
# for newer Armv8.x/v9 architectural extensions which they cannot expose.
# CONFIG_ARM64_TAGGED_ADDR_ABI is not set
# CONFIG_ARM64_HW_AFDBM is not set
# CONFIG_ARM64_PAN is not set
# CONFIG_ARM64_LSE_ATOMICS is not set
# CONFIG_ARM64_USE_LSE_ATOMICS is not set
# CONFIG_ARM64_RAS_EXTN is not set
# CONFIG_ARM64_CNP is not set
# CONFIG_ARM64_AMU_EXTN is not set
# CONFIG_ARM64_TLB_RANGE is not set
# CONFIG_ARM64_E0PD is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_POE is not set
# CONFIG_ARM64_HAFT is not set
# CONFIG_ARM64_GCS is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_BRBE is not set
