CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# brcmfmac is built into the kernel and initializes before rootfs is mounted.
# Embed only the BCM43455 firmware, its CLM database, CM4 NVRAM and regdb.
CONFIG_EXTRA_FIRMWARE="brcm/brcmfmac43455-sdio.bin brcm/brcmfmac43455-sdio.raspberrypi,4-compute-module.bin brcm/brcmfmac43455-sdio.clm_blob brcm/brcmfmac43455-sdio.raspberrypi,4-compute-module.txt regulatory.db"
CONFIG_EXTRA_FIRMWARE_DIR="roki-cm4-firmware"

# No containers or swap are needed on the robot head.
# CONFIG_NAMESPACES is not set
# CONFIG_SWAP is not set

# dinit is built without cgroup support and none of the appliance services use
# resource controllers.  Remove the entire cgroup hierarchy, including block
# throttling and its accounting state.
# CONFIG_CGROUPS is not set
# CONFIG_MEMCG is not set
# CONFIG_BLK_CGROUP is not set
# CONFIG_CGROUP_WRITEBACK is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_FAIR_GROUP_SCHED is not set
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_FREEZER is not set
# CONFIG_CPUSETS is not set
# CONFIG_CGROUP_DEVICE is not set
# CONFIG_CGROUP_CPUACCT is not set

# All hardware drivers for the appliance are built into the kernel. Do not
# carry the module loader, module metadata, or the module syscall surface.
# CONFIG_MODULES is not set

# The robot head has no suspend/wakeup workflow. Keep normal CPU idle and
# runtime PM, but omit system suspend-to-RAM and its task freezer.
# CONFIG_SUSPEND is not set
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_SCHED_AUTOGROUP is not set

# Preserve both IPC families for third-party userspace.  POSIX shared memory
# (/dev/shm) itself is a tmpfs feature, separate from POSIX message queues.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# No kexec or crash kernel is used.
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_FHANDLE is not set

# The image runs directly on BCM2711: no hypervisor, UEFI, NUMA, KASLR, CPU
# hotplug, or AArch32 userspace compatibility is needed.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_NUMA is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_COMPAT is not set
# CONFIG_COMPAT_32BIT_TIME is not set

# BCM2711 is in the Raspberry Pi BCM2835 family, not the unrelated Broadcom
# set-top-box family.  The BCM PCIe driver works with ARCH_BCM2835 directly.
CONFIG_ARCH_BCM2835=y
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_RESET_BRCMSTB is not set
# CONFIG_RESET_BRCMSTB_RESCAL is not set
# CONFIG_RESET_SIMPLE is not set
# CONFIG_ARM_SMCCC_SOC_ID is not set
# CONFIG_SND_DRIVERS is not set

# Firmware supplies the actual command line.  Keep the same string in the
# kernel as a fallback for a bootloader which does not pass one.
CONFIG_CMDLINE="root=/dev/mmcblk0p2 rootfstype=ext4 ro fsck.repair=yes rootwait init=/usr/bin/dinit"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_CMDLINE_FORCE is not set

# Cortex-A72 implements ARMv8.0 only. PAN and the later PAC/BTI/EPAN
# extensions cannot be used by BCM2711, so omit their kernel support.
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY is not set
# CONFIG_ARM64_PAN is not set
# CONFIG_ARM64_EPAN is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set

# This is a production appliance, not a kernel development target.
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_UPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set

# No LSM policy, audit stream, or security filesystem is used on the head.
# CONFIG_AUDIT is not set
# CONFIG_AUDITSYSCALL is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITYFS is not set
# CONFIG_SECURITY_NETWORK is not set
# CONFIG_SECURITY_PATH is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_YAMA is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# CONFIG_SECURITY_LANDLOCK is not set
# CONFIG_SECURITY_IPE is not set

# BCM2711 uses Cortex-A72. Keep its sole relevant erratum (1319367) and drop
# all workarounds for unrelated ARM cores and third-party SoCs.
# CONFIG_AMPERE_ERRATUM_AC03_CPU_38 is not set
# CONFIG_AMPERE_ERRATUM_AC04_CPU_23 is not set
# CONFIG_ARM64_ERRATUM_826319 is not set
# CONFIG_ARM64_ERRATUM_827319 is not set
# CONFIG_ARM64_ERRATUM_824069 is not set
# CONFIG_ARM64_ERRATUM_819472 is not set
# CONFIG_ARM64_ERRATUM_832075 is not set
# CONFIG_ARM64_ERRATUM_834220 is not set
# CONFIG_ARM64_ERRATUM_1742098 is not set
# CONFIG_ARM64_ERRATUM_845719 is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_ARM64_ERRATUM_1024718 is not set
# CONFIG_ARM64_ERRATUM_1418040 is not set
# CONFIG_ARM64_ERRATUM_1165522 is not set
CONFIG_ARM64_ERRATUM_1319367=y
# CONFIG_ARM64_ERRATUM_1530923 is not set
# CONFIG_ARM64_ERRATUM_2441007 is not set
# CONFIG_ARM64_ERRATUM_1286807 is not set
# CONFIG_ARM64_ERRATUM_1463225 is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set
# CONFIG_ARM64_ERRATUM_1508412 is not set
# CONFIG_ARM64_ERRATUM_2051678 is not set
# CONFIG_ARM64_ERRATUM_2077057 is not set
# CONFIG_ARM64_ERRATUM_2658417 is not set
# CONFIG_ARM64_ERRATUM_2054223 is not set
# CONFIG_ARM64_ERRATUM_2067961 is not set
# CONFIG_ARM64_ERRATUM_2441009 is not set
# CONFIG_ARM64_ERRATUM_2457168 is not set
# CONFIG_ARM64_ERRATUM_2645198 is not set
# CONFIG_ARM64_ERRATUM_2966298 is not set
# CONFIG_ARM64_ERRATUM_3117295 is not set
# CONFIG_ARM64_ERRATUM_3194386 is not set
# CONFIG_ARM64_ERRATUM_4193714 is not set
# CONFIG_ARM64_ERRATUM_4118414 is not set
# CONFIG_CAVIUM_ERRATUM_22375 is not set
# CONFIG_CAVIUM_ERRATUM_23144 is not set
# CONFIG_CAVIUM_ERRATUM_23154 is not set
# CONFIG_CAVIUM_ERRATUM_27456 is not set
# CONFIG_CAVIUM_ERRATUM_30115 is not set
# CONFIG_CAVIUM_TX2_ERRATUM_219 is not set
# CONFIG_FUJITSU_ERRATUM_010001 is not set
# CONFIG_HISILICON_ERRATUM_161600802 is not set
# CONFIG_HISILICON_ERRATUM_162100801 is not set
# CONFIG_HISILICON_ERRATUM_161010101 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1003 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_1009 is not set
# CONFIG_QCOM_QDF2400_ERRATUM_0065 is not set
# CONFIG_QCOM_FALKOR_ERRATUM_E1041 is not set
# CONFIG_NVIDIA_CARMEL_CNP_ERRATUM is not set
# CONFIG_ROCKCHIP_ERRATUM_3568002 is not set
# CONFIG_ROCKCHIP_ERRATUM_3588001 is not set
# CONFIG_SOCIONEXT_SYNQUACER_PREITS is not set
# CONFIG_ARM64_ERRATUM_858921 is not set

# IWD works without kernel keyrings for WPA-PSK. Keep module signing and
# integrity verification disabled as well.
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_KEYS is not set
# CONFIG_SYSTEM_DATA_VERIFICATION is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_INTEGRITY is not set
# CONFIG_IMA is not set
# CONFIG_EVM is not set

# The robot does not run high-throughput server workloads. Keep the legacy
# synchronous socket and device APIs and omit the io_uring subsystem.
# CONFIG_IO_URING is not set

# UDP-Lite accepts partially corrupted datagrams and is not used by the robot.
# CONFIG_IP_UDP_LITE is not set

# No network or distributed filesystems are used on the robot head.
# They otherwise select the kernel keyring infrastructure.
# CONFIG_BLK_DEV_RBD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CEPH_LIB is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set

# Only the internal brcmfmac SDIO Wi-Fi is used. No USB/networked storage,
# legacy Broadcom WLAN, or USB Ethernet/WWAN adapters are present.
# CONFIG_USB_USBNET is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_USB_APPLEDISPLAY is not set
# CONFIG_RTL8187 is not set
# CONFIG_R8169 is not set
# CONFIG_IGB is not set
# CONFIG_ATA is not set
# CONFIG_TYPEC_TCPM is not set

# No virtual, CAN, PPP, SLIP, USB Ethernet, or non-CM4 network hardware.
# CONFIG_BONDING is not set
# CONFIG_DUMMY is not set
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# CONFIG_IPVLAN is not set
# CONFIG_TUN is not set
# CONFIG_TAP is not set
# CONFIG_VETH is not set
# CONFIG_VSOCKMON is not set
# CONFIG_CAN_DEV is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_MACB is not set
# CONFIG_IXGBE is not set
# CONFIG_I40E is not set
# CONFIG_IGC is not set
# CONFIG_ENC28J60 is not set
# CONFIG_LAN743X is not set
# CONFIG_QCA7000 is not set
# CONFIG_MSE102X is not set
# CONFIG_WIZNET_W5100 is not set
# CONFIG_QCA7000_SPI is not set
# CONFIG_QCA7000_UART is not set

# Only brcmfmac SDIO is needed for WLAN.
# CONFIG_ATH9K is not set
# CONFIG_ATH9K_HTC is not set
# CONFIG_CARL9170 is not set
# CONFIG_ATH6KL is not set
# CONFIG_AR5523 is not set
# CONFIG_AT76C50X_USB is not set
# CONFIG_IWLWIFI is not set
# CONFIG_P54_COMMON is not set
# CONFIG_LIBERTAS is not set
# CONFIG_MWIFIEX is not set
# CONFIG_MT7601U is not set
# CONFIG_MT76_CORE is not set
# CONFIG_RT2X00 is not set
# CONFIG_RTL_CARDS is not set
# CONFIG_RTW88 is not set
# CONFIG_RTW89 is not set
# CONFIG_WL12XX is not set
# CONFIG_ZD1211RW is not set
# CONFIG_MAC80211_HWSIM is not set

# brcmfmac is FullMAC and only depends on cfg80211. No legacy WEXT or 802.11s
# mesh stack is needed.
# CONFIG_MAC80211 is not set
# CONFIG_MAC80211_MESH is not set
# CONFIG_WEXT_CORE is not set
# CONFIG_WEXT_PROC is not set
# CONFIG_WEXT_SPY is not set

# Disable complete wireless/network device families that have no hardware on
# the carrier. Keep the Broadcom vendor menu for brcmfmac SDIO.
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
CONFIG_WLAN_VENDOR_BROADCOM=y
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
# CONFIG_BRCMSMAC is not set

# No Bluetooth, CAN, amateur-radio, NFC, ATM, virtual sockets, or mesh links.
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_ATM is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_VSOCKETS is not set
# CONFIG_AX25 is not set
# CONFIG_NETROM is not set
# CONFIG_ROSE is not set
# CONFIG_NET_9P is not set
# CONFIG_NFC is not set

# ss relies on these socket-diag netlink families. Retain them explicitly as
# the network configuration is otherwise intentionally minimal.
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y
CONFIG_INET_DIAG_DESTROY=y

# BINFMT_SCRIPT handles normal #! interpreters. No transparent foreign-binary
# handlers, kernel DNS upcalls, or generic connector users are present.
# CONFIG_BINFMT_MISC is not set
# CONFIG_DNS_RESOLVER is not set
# CONFIG_CONNECTOR is not set

# The eMMC is the only persistent block device: no flash/MTD, zram or remote
# block transports are present.
# CONFIG_MTD is not set
# CONFIG_ZRAM is not set
# CONFIG_BLK_DEV_DRBD is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_ATA_OVER_ETH is not set
# CONFIG_BLK_DEV_INTEGRITY is not set
# CONFIG_BLK_DEV_THROTTLING is not set

# genimage creates an MBR partition table: boot and rootfs are mmcblk0p1/p2.
# Keep only the MSDOS parser; Mac and GPT support cannot be used by this image.
CONFIG_PARTITION_ADVANCED=y
# CONFIG_MAC_PARTITION is not set
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_BLOCK_LEGACY_AUTOLOAD is not set
CONFIG_MODULE_FORCE_UNLOAD=y

# mq-deadline is the only scheduler needed for the eMMC's mixed rootfs and
# video-write workload. BFQ and Kyber add policies with no consumer here.
CONFIG_MQ_IOSCHED_DEADLINE=y
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BFQ_GROUP_IOSCHED is not set

# The only USB functions are ACM, audio, and NCS2. GPIO buttons are the sole
# input device, so no USB HID/gamepad stack is needed.
# CONFIG_HID is not set
# CONFIG_USB_HID is not set
# CONFIG_JOYSTICK_PSXPAD_SPI_FF is not set
# CONFIG_JOYSTICK_XPAD_FF is not set

# No legacy or tunnel/virtual networking protocols are used.
# CONFIG_ATALK is not set
# CONFIG_OPENVSWITCH is not set
# CONFIG_GTP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_L2TP is not set
# CONFIG_VXLAN is not set
# CONFIG_NET_KEY is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_INET_XFRM_TUNNEL is not set
# CONFIG_XFRM_AH is not set
# CONFIG_XFRM_ESP is not set
# CONFIG_XFRM_IPCOMP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_XFRM_ALGO is not set

# CONFIG_BLK_DEV_BSGLIB is not set

# GPIO keys on the MCP23008 are the only input source.
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_MATRIXKMAP is not set
# CONFIG_KEYBOARD_TCA8418 is not set
# CONFIG_KEYBOARD_MATRIX is not set
# CONFIG_KEYBOARD_CAP11XX is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_SERIO is not set

# No software, USB, or third-party I2C/SPI controllers are fitted.
# CONFIG_I2C_ALGOBIT is not set
# CONFIG_I2C_GPIO is not set
# CONFIG_I2C_ROBOTFUZZ_OSIF is not set
# CONFIG_I2C_TINY_USB is not set
# CONFIG_I2C_HELPER_AUTO is not set
# CONFIG_SPI_RP2040_GPIO_BRIDGE is not set
# CONFIG_SPI_SLAVE is not set
# CONFIG_GPIO_FSM is not set
# CONFIG_GPIO_MOCKUP is not set
# CONFIG_MFD_SIMPLE_MFD_I2C is not set

# Only the Arducam Pivariety camera is installed on CSI1.
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_MEDIA_PCI_SUPPORT is not set
# CONFIG_V4L2_CCI is not set
# CONFIG_V4L2_CCI_I2C is not set
# CONFIG_VIDEO_RP1_CFE is not set
# CONFIG_VIDEO_RP1_CFE_DOWNSTREAM is not set
# CONFIG_VIDEO_ARDUCAM_64MP is not set
# CONFIG_VIDEO_IMX219 is not set
# CONFIG_VIDEO_IMX258 is not set
# CONFIG_VIDEO_IMX283 is not set
# CONFIG_VIDEO_IMX290 is not set
# CONFIG_VIDEO_IMX296 is not set
# CONFIG_VIDEO_IMX335 is not set
# CONFIG_VIDEO_IMX355 is not set
# CONFIG_VIDEO_IMX415 is not set
# CONFIG_VIDEO_IMX477 is not set
# CONFIG_VIDEO_IMX500 is not set
# CONFIG_VIDEO_IMX519 is not set
# CONFIG_VIDEO_IMX708 is not set
# CONFIG_VIDEO_MIRA220 is not set
# CONFIG_VIDEO_MT9V011 is not set
# CONFIG_VIDEO_OV2311 is not set
# CONFIG_VIDEO_OV5647 is not set
# CONFIG_VIDEO_OV64A40 is not set
# CONFIG_VIDEO_OV7251 is not set
# CONFIG_VIDEO_OV7640 is not set
# CONFIG_VIDEO_OV9282 is not set
# CONFIG_VIDEO_VD55G1 is not set
# CONFIG_VIDEO_VD56G3 is not set
# CONFIG_VIDEO_AD5398 is not set
# CONFIG_VIDEO_AK7375 is not set
# CONFIG_VIDEO_BU64754 is not set
# CONFIG_VIDEO_DW9807_VCM is not set
# CONFIG_VIDEO_CS53L32A is not set
# CONFIG_VIDEO_MSP3400 is not set
# CONFIG_VIDEO_SONY_BTF_MPX is not set
# CONFIG_VIDEO_UDA1342 is not set
# CONFIG_VIDEO_WM8775 is not set
# CONFIG_VIDEO_ADV7180 is not set
# CONFIG_VIDEO_SAA711X is not set
# CONFIG_VIDEO_TC358743 is not set
# CONFIG_VIDEO_TVP5150 is not set
# CONFIG_VIDEO_TW2804 is not set
# CONFIG_VIDEO_TW9903 is not set
# CONFIG_VIDEO_TW9906 is not set
# CONFIG_VIDEO_IRS1125 is not set
# CONFIG_VIDEO_CX25840 is not set
# CONFIG_HDMI is not set

# Audio is I2S MAX98357A plus a USB microphone, without MIDI or PCI/SPI cards.
# CONFIG_SND_PCI is not set
# CONFIG_SND_SPI is not set
# CONFIG_SND_UMP is not set
# CONFIG_SND_BCM2708_SOC_HIFIBERRY_STUDIO is not set
# CONFIG_SND_SOC_RL6231 is not set
# CONFIG_SND_SOC_RT5616 is not set
# CONFIG_SND_USB_AUDIO_MIDI_V2 is not set

# USB is host-only: XHCI, CDC ACM, and class-compliant audio.
# CONFIG_USB_CYPRESS_CY7C63 is not set
# CONFIG_USB_CYTHERM is not set
# CONFIG_USB_IDMOUSE is not set
# CONFIG_TYPEC is not set
# CONFIG_MMC_SPI is not set

# The board has no MAX730x expander or force-feedback input devices.
# CONFIG_GPIO_MAX7301 is not set
# CONFIG_INPUT_FF is not set

# CM4 exposes its USB3 controller through the BCM2711 PCIe root port.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_BRCMSTB=y
# No RP1 downstream PCIe devices: do not synthesize runtime DT nodes for PCI.
# CONFIG_PCI_DYNAMIC_OF_NODES is not set
# CONFIG_PCI_STUB is not set
# CONFIG_PCI_PF_STUB is not set
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_ATS is not set
# CONFIG_PCI_PRI is not set
# CONFIG_PCI_PASID is not set
# CONFIG_PCI_P2PDMA is not set
# CONFIG_PCI_DOE is not set
# CONFIG_PCI_NPEM is not set
# CONFIG_PCIEAER is not set
# CONFIG_PCIE_DPC is not set
# CONFIG_PCIE_PTM is not set
# CONFIG_PCIE_EDR is not set

# USB hosts: PCIe Renesas uPD720201 and the native BCM2711 USB2 xHCI port.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PCI_RENESAS=y
CONFIG_USB_XHCI_PLATFORM=y
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_ROLE_SWITCH is not set
# CONFIG_PHY_BRCM_USB is not set
CONFIG_USB_ACM=y
CONFIG_SND_USB_AUDIO=y

# Keep only the CSI-2 receiver, the Arducam sensor and the BCM2835 ISP.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
CONFIG_VIDEO_CODEC_BCM2835=y
# CONFIG_VIDEO_BCM2835 is not set

CONFIG_EXPERT=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# CM4 network and storage controllers are part of the board, not loadable
# peripherals. The Wi-Fi firmware itself is supplied separately.
# brcmfmac is FullMAC and does not need mac80211.
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BCMGENET=y

# The fixed CM4 eMMC and on-module Wi-Fi SDIO use only BCM2835 MMC and the
# BCM/iProc SDHCI path. No removable-card, PCI, SPI, test or queue features.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2835_MMC=y
CONFIG_MMC_BCM2835_DMA=y
# CONFIG_MMC_BCM2835 is not set
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
# CONFIG_MMC_SDHCI_BRCMSTB is not set
# CONFIG_MMC_SDHCI_PCI is not set
# CONFIG_MMC_CQHCI is not set
# CONFIG_MMC_HSQ is not set
# CONFIG_SDIO_UART is not set
# CONFIG_MMC_TEST is not set
# CONFIG_MMC_DEBUG is not set

# UARTs, I2C, SPI and GPIO devices described in the CM4 DT/overlays.
# CONFIG_SERIAL_8250 is not set
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y
# CONFIG_I2C_BCM2708 is not set
# CONFIG_I2C_BRCMSTB is not set
# CONFIG_I2C_DESIGNWARE_CORE is not set
# CONFIG_I2C_MUX is not set
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y
# CONFIG_SPI_BCM2835AUX is not set
# CONFIG_SPI_BITBANG is not set
# CONFIG_SPI_DESIGNWARE is not set
# CONFIG_SPI_GPIO is not set
CONFIG_PINCTRL_MCP23S08=y
CONFIG_PINCTRL_MCP23S08_I2C=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_BCM2711_THERMAL=y
# BCM2711 has its own AVS thermal sensor; BCM2835 thermal is for older SoCs.
# CONFIG_BCM2835_THERMAL is not set
CONFIG_RTC_DRV_DS1307=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# Audio: MAX98357A I2S speaker amplifiers and class-compliant USB audio only.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_HWDEP=y
CONFIG_SND_RAWMIDI=y
# Fixed ALSA device numbering is sufficient for the I2S amplifier and USB microphone.
# CONFIG_SND_DYNAMIC_MINORS is not set
CONFIG_SND_MAX_CARDS=4
# Keep /proc/asound for field diagnostics of the I2S amplifier and USB microphone.
CONFIG_SND_PROC_FS=y
CONFIG_SND_VERBOSE_PROCFS=y
# The USB microphone does not use V4L2 media-controller integration.
# CONFIG_SND_USB_AUDIO_USE_MEDIA_CONTROLLER is not set
