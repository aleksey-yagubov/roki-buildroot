# Camera pipeline. Unicam DMA-captures CSI-2 into RAM; the ISP is a VCHIQ/MMAL
# VideoCore service and shares those buffers through DMA-BUF.
CONFIG_VIDEO_ARDUCAM_PIVARIETY=y
CONFIG_VIDEO_BCM2835_UNICAM=y
CONFIG_VIDEO_ISP_BCM2835=y
CONFIG_BCM2835_VCHIQ=y
CONFIG_BCM2835_VCHIQ_MMAL=y
CONFIG_BCM2835_MBOX=y
CONFIG_DMA_CMA=y
# Keep the 256 MiB DMA pool in the kernel, not in linux,cma-default DT.
CONFIG_CMA_SIZE_MBYTES=256
CONFIG_CMA_SIZE_SEL_MBYTES=y

# The RPi ISP needs VCHIQ/MMAL above, but no shipped userspace uses the raw
# VideoCore character devices. Keep them absent from the image.
# CONFIG_VCHIQ_CDEV is not set
# CONFIG_BRCM_CHAR_DRIVERS is not set
# CONFIG_BCM2708_VCMEM is not set
# CONFIG_BCM_VCIO is not set

